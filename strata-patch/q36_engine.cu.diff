+// STRATA_Q36_VRAM_CAP=<GiB>: pretend the card has that much VRAM (all free-memory decisions follow it; nothing is enforced).
+// Unset = the real card, behaviour unchanged.
+static cudaError_t capMemInfo(size_t* fr, size_t* tot) {
+    const cudaError_t e = cudaMemGetInfo(fr, tot);
+    if (e != cudaSuccess) return e;
+    const char* c = std::getenv("STRATA_Q36_VRAM_CAP");
+    if (c && *c) {
+        const double gib = std::atof(c);
+        if (gib > 0) {
+            const size_t cap = (size_t) (gib * 1073741824.0);
+            const size_t used = *tot - *fr;
+            if (cap < *tot) {
+                *tot = cap;
+                *fr = used >= cap ? 0 : cap - used;
+            }
+        }
+    }
+    return cudaSuccess;
+}
+float* halloc(size_t n) {   // pinned host memory the device reads and writes directly (STRATA_Q36_KVHOST=1)
+    float* p = nullptr;
+    CK(cudaHostAlloc((void**) &p, n * 4, cudaHostAllocDefault));
+    std::memset(p, 0, n * 4);
+    return p;
+}
